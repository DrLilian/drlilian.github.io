# Only needed if you want to preview the site locally before pushing.
# GitHub Pages itself builds the site for you — you do NOT need Ruby to deploy.
source "https://rubygems.org"

# Matches the exact set of plugins/versions GitHub Pages runs.
gem "github-pages", group: :jekyll_plugins

# Windows / JRuby compatibility helpers
gem "tzinfo-data", platforms: [:mingw, :x64_mingw, :mswin, :jruby]
gem "wdm", "~> 0.1.1", platforms: [:mingw, :x64_mingw, :mswin]
